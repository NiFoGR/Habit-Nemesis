<?xml version="1.0" encoding="utf-8"?>
<!-- Fixture widget, 4x2: crest, division, two lanes on one scale, the verdict. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hnw_fixture_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnw_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/hnw_fixture_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/hnw_no_match"
        android:textColor="#97a1b0"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/hnw_fixture_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hnw_fixture_division"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#97a1b0"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/hnw_fixture_crest"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hnw_you"
                android:textColor="#e6eaf0"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/hnw_fixture_you_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:progress="0"
                android:progressDrawable="@drawable/hnw_bar_you" />

            <TextView
                android:id="@+id/hnw_fixture_you_pct"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#e6eaf0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hnw_fixture_them_name"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#97a1b0"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/hnw_fixture_them_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="8dp"
                android:minHeight="8dp"
                android:progress="0"
                android:progressDrawable="@drawable/hnw_bar_them" />

            <TextView
                android:id="@+id/hnw_fixture_them_pct"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#97a1b0"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hnw_fixture_verdict"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#97a1b0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hnw_fixture_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#6b7686"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
