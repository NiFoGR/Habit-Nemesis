<?xml version="1.0" encoding="utf-8"?>
<!-- Grid widget: day labels, then one added row per habit, oldest day on the left. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hnw_grid_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hnw_widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Same weights as a row, so the columns line up. -->
    <LinearLayout
        android:id="@+id/hnw_grid_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3" />

        <TextView
            android:id="@+id/hnw_grid_d0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#6b7686"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/hnw_grid_d1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#6b7686"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/hnw_grid_d2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#6b7686"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/hnw_grid_d3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#6b7686"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hnw_grid_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/hnw_grid_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#6b7686"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hnw_grid_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/hnw_no_habits"
        android:textColor="#97a1b0"
        android:textSize="13sp" />
</LinearLayout>
