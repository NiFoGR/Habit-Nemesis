node_modules/
# Generated by `npx cap add android` — rebuilt from www/ on every build.
# Anchored with a leading slash: an unanchored "android/" also matches
# native/systemui/android/, which is source and has to be committed.
/android/
/ios/
*.apk
*.log
.DS_Store

# Signing keys. The release key never enters the repo: it lives in CI secrets.
# The debug key is the exception and is committed on purpose, so sideloaded
# builds install over each other. signing/README.md says why that is safe.
*.keystore
*.jks
*.p12
!signing/debug.keystore
